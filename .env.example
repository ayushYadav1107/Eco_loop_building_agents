# ---------------------------------------------------------------------------
# Eco-Loop Building Agents - environment configuration
# Copy to `.env` and edit.
# ---------------------------------------------------------------------------

# Root of the EnergyPlus installation (the folder that CONTAINS `pyenergyplus/`)
# Windows : C:\EnergyPlusV9-6-0
# macOS   : /Applications/EnergyPlus-9-6-0
# Linux   : /usr/local/EnergyPlus-9-6-0
ENERGYPLUS_DIR=

# Simulation model (leave blank to use the files staged by scripts/prepare_model.py)
ECOLOOP_IDF=
ECOLOOP_EPW=

# --- Local LLM (Ollama default; vLLM: http://localhost:8000/v1) -------------
ECOLOOP_LLM_BASE_URL=http://localhost:11434/v1
ECOLOOP_LLM_API_KEY=ollama
ECOLOOP_LLM_MODEL=llama3.1:8b
ECOLOOP_LLM_TEMPERATURE=0.1

# --- Closed-loop timing -----------------------------------------------------
# How often (simulated minutes) the LLM is allowed to reason. 15 or 60.
ECOLOOP_CONTROL_INTERVAL_MIN=15
# Hard wall-clock budget for one full agent turn, seconds. Exceeded => fallback.
ECOLOOP_LLM_TIMEOUT_S=25

# --- MCP bus ----------------------------------------------------------------
ECOLOOP_MCP_HOST=127.0.0.1
ECOLOOP_MCP_PORT=8848
# "direct" = in-process tool dispatch (lowest latency)
# "mcp"    = tools invoked over the FastMCP HTTP session (protocol-faithful)
ECOLOOP_TOOL_TRANSPORT=mcp
